---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'de';
const de = lang === 'de';
const q = de ? '' : '?lang=en';
const code = `<iframe src="${SITE_URL}/embed/balkonkraftwerk-rechner/${q}" title="${de ? 'Balkonkraftwerk-Rechner' : 'Plug-in solar calculator'}" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/photovoltaik-rechner/${q}" title="${de ? 'Photovoltaik-Rechner' : 'Rooftop PV calculator'}" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Balkonkraftwerk-Rechner und PV-Rechner kostenlos einbinden" description="Binden Sie den Balkonkraftwerk-Rechner oder den Photovoltaik-Rechner 2026 kostenlos per iframe ein: Code kopieren, ohne Konto, ohne Cookies, Werte aktualisieren sich selbst." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: de ? 'Start' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{de ? 'Einen Solarrechner einbinden' : 'Embed a solar calculator'}</h1>
    <p class="mt-3 text-lg text-navy-700">{de ? 'Für Energieagenturen, Mietervereine, Solarvereine und Lokalredaktionen: einmal kopieren, Fördersätze und Strompreise aktualisieren sich von selbst.' : 'For energy agencies, tenant associations, solar clubs and local newsrooms: copy once, rates and prices update themselves.'}</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>{de ? 'Balkonkraftwerk-Rechner' : 'Plug-in solar calculator'}</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>{de ? 'Photovoltaik-Rechner' : 'Rooftop PV calculator'}</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>{de ? 'Bedingungen: Der Quellenlink unter dem Rechner bleibt sichtbar, der Rechner wird nicht verändert, er wird ohne Gewähr bereitgestellt. Was Ihre Leser eintippen, bleibt auf deren Gerät; der Rahmen setzt keine Cookies und misst nichts.' : 'Terms: the source link under the calculator stays visible, the calculator is not modified, and it is provided without warranty. What your readers type stays on their device; the frame sets no cookies and measures nothing.'} <a href={route('contact', lang)}>{de ? 'Fragen' : 'Questions'}</a></p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/balkonkraftwerk-rechner/${q}`} title={de ? 'Balkonkraftwerk-Rechner' : 'Plug-in solar calculator'} width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
